{
  "name": "napcat-omnibot-v2",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Staged rewrite skeleton for Napcat-OmniBot v2.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/miobot-service.mjs",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/apps/bot/src',{recursive:true});fs.copyFileSync('apps/bot/capabilities-http.json','dist/apps/bot/src/capabilities-http.json');console.log('JSON assets copied')\"",
    "test": "npm run build && node --test tests/*.test.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start:verify": "node scripts/local-verify-server.mjs",
    "start:bot-v2": "node scripts/bot-runtime-v2.mjs",
    "trace:canvas": "node scripts/trace-canvas-generation.mjs",
    "check:chromium": "node scripts/check-chromium.mjs",
    "check:r9": "node scripts/r9-readiness.mjs",
    "check:r10:topology": "node scripts/r10-live-topology.mjs",
    "check:r10:intent": "node scripts/r10-compare-intent.mjs",
    "check:r10:suno-prompt": "node scripts/r10-live-suno-prompt.mjs",
    "check:r9:externals": "node scripts/r9-readiness.mjs --strict-externals",
    "soak:r9": "node scripts/r9-live-soak.mjs",
    "soak:r9:spend": "node scripts/r9-live-soak.mjs --spend --wait --count=1",
    "deploy:linux": "bash deploy-linux.sh"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20.12.7",
    "@types/pdfkit": "^0.17.6",
    "@types/ws": "^8.5.13",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@orama/plugin-data-persistence": "^3.1.18",
    "adm-zip": "^0.6.1",
    "app-info-parser": "^1.1.6",
    "archiver": "^8.0.0",
    "docx": "^9.12.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "iconv-lite": "^0.7.3",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "playwright-core": "^1.64.1",
    "pptxgenjs": "^4.0.1",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.3"
  }
}
